{
  "name": "business-workspace",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "main": "electron.js",
  "dependencies": {
    "@emotion/react": "^11.10.0",
    "@emotion/styled": "^11.10.0",
    "@mui/icons-material": "^6.4.0",
    "cra-template": "1.2.0",
    "jspdf": "^2.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--no-deprecation react-scripts start",
    "build": "cross-env NODE_OPTIONS=--no-deprecation react-scripts build",
    "test": "cross-env NODE_OPTIONS=--no-deprecation react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win",
    "electron:build:main": "electron-builder --win -c.productName=\"Hospital App Main\" -c.directories.output=\"../dist/main\"",
    "electron:build:client": "electron-builder --win -c.productName=\"Hospital App Client\" -c.extraResources=[] -c.directories.output=\"../dist/client\""
  },
  "build": {
    "extends": null,
    "appId": "com.hospital.app",
    "productName": "Hospital App",
    "files": [
      "build/**/*",
      "electron.js"
    ],
    "directories": {
      "buildResources": "public",
      "output": "../dist"
    },
    "win": {
      "target": "nsis",
      "sign": "sign-mock.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "../nodeApp",
        "to": "nodeApp",
        "filter": [
          "**/*",
          "!**/node_modules/nodemon/**",
          "!**/*.exe"
        ]
      }
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001810",
    "cross-env": "^10.1.0",
    "electron": "^35.1.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16"
  }
}
